# Copy this file to  .env  (same folder as requirements.txt) and fill it in.
# NEVER commit .env. Restart uvicorn after editing it.

# ---------------- LLM (any OpenAI-compatible provider) ----------------
# Default provider: OpenRouter. Pick a model slug from https://openrouter.ai/models
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1

# Hugging Face Inference Providers instead (use a token with "Make calls to Inference Providers"):
#   LLM_BASE_URL=https://router.huggingface.co/v1
#   LLM_API_KEY=hf_your_token_here
#   LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct:cerebras      (format: org/model[:provider])
# Local Ollama:   LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=<model you pulled>

# Optional tuning
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2
# LLM_MAX_TOKENS=500          # raise this for "thinking" models, they spend tokens before answering
# LLM_TEMPERATURE=0.6         # leave empty to not send it (some reasoning models reject it)
# LLM_MERGE_SYSTEM_PROMPT=true  # set if the model errors on system messages (some small models do)
# LLM_SITE_URL=               # optional OpenRouter attribution
# LLM_SITE_TITLE=NFC Employee Welcome

# ---------------- Assistant ----------------
# ASSISTANT_SESSION_IDLE_HOURS=24     # idle time before a session is dropped; 0 = never
# ASSISTANT_MAX_HISTORY_MESSAGES=40   # oldest messages are dropped beyond this (20 exchanges)
# ASSISTANT_TIMEZONE=Asia/Kolkata
# ASSISTANT_SYSTEM_PROMPT=            # replaces the built-in prompt (the built-in one contains the safety rules)

# ---------------- MQTT (light control, used by /voice-command) ----------------
MQTT_USERNAME=
MQTT_PASSWORD=
# MQTT_HOST=10.1.1.177
# MQTT_PORT=1883
# MQTT_TOPIC=relayCtr
# MQTT_DEVICE_NAME=2c:bc:bb:0d:07:20

# ---------------- Database (already supported) ----------------
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nfc_attendance
